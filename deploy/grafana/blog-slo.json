          "legendFormat": "Доля хорошего времени",
          "datasource": {
            "type": "prometheus",
            "uid": "blog-slo-vm"
          }
        },
        {
          "refId": "B",
          "expr": "vector(99)",
          "legendFormat": "SLA 99%",
          "datasource": {
            "type": "prometheus",
