    {
      "id": 5,
      "title": "Пробер: доступность и время ответа",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "blog-slo-vm"
      },
      "description": "1 означает выполнение проверки, 0 означает сбой. Хороший интервал требует ответа двух страниц ≤ 1 секунды и свежих данных.",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "blog_probe_success{job=\"blog-prober\"}",
          "legendFormat": "HTTP и содержимое, {{target}}",
          "datasource": {
            "type": "prometheus",
            "uid": "blog-slo-vm"
          }
        },
        {
          "refId": "B",
          "expr": "up{job=\"blog-prober\"}",
          "legendFormat": "Сбор пробера",
          "datasource": {
            "type": "prometheus",
            "uid": "blog-slo-vm"
          }
        },
        {
          "refId": "C",
          "expr": "(\n  (min(last_over_time(blog_probe_round_good{job=\"blog-prober\"}[30s])) default vector(0))\n  * (min(last_over_time(up{job=\"blog-prober\"}[30s])) default vector(0))\n  * ((time() - max(last_over_time(blog_probe_last_run_timestamp_seconds{job=\"blog-prober\"}[30s])) < bool 30) default vector(0))\n) if (count(last_over_time(blog_probe_started_timestamp_seconds{job=\"blog-prober\"}[7d])) > 0)",
          "legendFormat": "Хороший интервал",
          "datasource": {
            "type": "prometheus",
            "uid": "blog-slo-vm"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "showPoints": "auto",
            "spanNulls": false,
