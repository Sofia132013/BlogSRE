    {
      "id": 4,
      "title": "SLI: p95 чтения, SLO ≤ 1 секунды",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "blog-slo-vm"
      },
      "description": "95% просмотров главной и поста укладываются в показанное время. Служебные запросы исключены.",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum(rate(django_http_requests_latency_seconds_by_view_method_bucket{job=\"blog-web\",view=~\"index|post_view\",method=\"GET\"}[2m])) by (le))",
          "legendFormat": "p95",
          "datasource": {
            "type": "prometheus",
            "uid": "blog-slo-vm"
          }
        },
        {
          "refId": "B",
          "expr": "vector(1)",
          "legendFormat": "SLO 1 секунда",
          "datasource": {
            "type": "prometheus",
            "uid": "blog-slo-vm"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
