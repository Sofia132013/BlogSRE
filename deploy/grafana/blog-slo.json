    {
      "id": 9,
      "title": "SLA выполнено: 1 да, 0 нет",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "blog-slo-vm"
      },
      "description": "Все три RBSLO и TBSLO должны быть ≥ 99%. Если нет данных о действиях, общего подтверждения нет.",
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(100 * sum(increase(blog_posts_created_total{job=\"blog-web\"}[$sla_window])) / (sum(increase(blog_business_attempts_total{job=\"blog-web\",operation=\"post\"}[$sla_window])) > 0) >= bool 99) * (100 * sum(increase(blog_comments_created_total{job=\"blog-web\"}[$sla_window])) / (sum(increase(blog_business_attempts_total{job=\"blog-web\",operation=\"comment\"}[$sla_window])) > 0) >= bool 99) * (100 * sum(increase(blog_user_registrations_total{job=\"blog-web\"}[$sla_window])) / (sum(increase(blog_business_attempts_total{job=\"blog-web\",operation=\"registration\"}[$sla_window])) > 0) >= bool 99) * (100 * avg_over_time(((\n  (min(last_over_time(blog_probe_round_good{job=\"blog-prober\"}[30s])) default vector(0))\n  * (min(last_over_time(up{job=\"blog-prober\"}[30s])) default vector(0))\n  * ((time() - max(last_over_time(blog_probe_last_run_timestamp_seconds{job=\"blog-prober\"}[30s])) < bool 30) default vector(0))\n) if (count(last_over_time(blog_probe_started_timestamp_seconds{job=\"blog-prober\"}[7d])) > 0))[$sla_window:15s]) >= bool 99)",
          "legendFormat": "Все обязательства SLA",
