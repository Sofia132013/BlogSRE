# Generate a unique value before deployment, for example:
# python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# For access from another LAN device, add the current host IP to
# DJANGO_ALLOWED_HOSTS in your local .env (for example, ...,10.240.19.129).
PORT=8001
DJANGO_LOG_LEVEL=INFO
APP_IMAGE=blog:local

# PostgreSQL service settings for docker compose.
POSTGRES_DB=blog
POSTGRES_USER=blog
POSTGRES_PASSWORD=change-me-before-deploying

# Leave false for a new database. To reuse an existing Docker volume, set its
# name and change POSTGRES_VOLUME_EXTERNAL to true. Keep its original DB password.
# POSTGRES_VOLUME_NAME=existing_postgres_data
POSTGRES_VOLUME_EXTERNAL=false

# Default local database; override DATABASE_URL for an external PostgreSQL server.
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}

# Use SMTP in deployments that send mail. Dummy avoids logging reset links locally.
DJANGO_EMAIL_BACKEND=django.core.mail.backends.dummy.EmailBackend
